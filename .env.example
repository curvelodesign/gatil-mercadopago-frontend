# URL base da API do backend (Express). Em produção, aponta para o
# projeto Vercel do backend; em dev local, para o servidor Express local.
VITE_API_URL=http://localhost:4000/api

# Nome do parâmetro de query que o PagBank devolve na URL de retorno
# do checkout, usado para identificar o pedido pago. Ajustar assim que
# o suporte do PagBank confirmar o nome real do parâmetro.
VITE_ORDER_ID_PARAM=payment_id

VITE_META_PIXEL_ID=
# ID do Google Analytics 4 (G-XXXXXXXXXX). Só carrega depois do aceite de cookies.
VITE_GA4_ID=
# Pix dentro do site (Checkout Transparente), na doação (/doar) e na rifa (/rifa).
# Com "true", as duas oferecem Pix (na tela) ou cartão (Mercado Pago). O Checkout
# Pro do backend aceita só cartão: vazio, não há Pix em lugar nenhum.
VITE_PIX_NO_SITE=
# Ação de Natal: "true" = escolhe até 10 números, reserva por 15 min e paga o
# total (precisa do backend com /api/rifa/reservar). Vazio = paga e escolhe depois.
VITE_FLUXO_COMPLETO=
# Site key (pública) do Cloudflare Turnstile — anti-robô na reserva. A chave
# secreta vai só no backend (TURNSTILE_SECRET).
VITE_TURNSTILE_SITE_KEY=
# Só em `npm run dev`: "true" liga o backend falso em memória (ver .env.mock).
VITE_API_MOCK=
